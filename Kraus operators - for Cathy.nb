Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"$PrePrint", " ", "=", " ", "MatrixForm"}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Choi", " ", "representation"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GetChoi", "[", "Liou_", "]"}], " ", ":=", " ", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"L", " ", "=", " ", 
        RowBox[{"Length", "[", "Liou", "]"}]}], "}"}], ",", "\n", "\t", 
      RowBox[{"Transpose", "[", 
       RowBox[{"ArrayFlatten", "[", 
        RowBox[{"Partition", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Partition", "[", 
             RowBox[{
              RowBox[{"Liou", "\[LeftDoubleBracket]", 
               RowBox[{";;", ",", " ", "i"}], "\[RightDoubleBracket]"}], ",", 
              " ", 
              RowBox[{"Sqrt", "[", "L", "]"}]}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "L"}], "}"}]}], "]"}], ",", " ", 
          RowBox[{"Sqrt", "[", "L", "]"}]}], "]"}], "]"}], "]"}]}], "\n", 
     "]"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Kraus", " ", "operators"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GetKrausOperators", "[", "Choi_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"evals", ",", " ", "evecs"}], "}"}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"evals", ",", " ", "evecs"}], "}"}], " ", "=", " ", 
       RowBox[{"Eigensystem", "[", "Choi", "]"}]}], ";", "\n", "\t", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Partition", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{
             "evals", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
             "]"}], " ", 
            RowBox[{
            "evecs", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}],
            ",", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"Length", "[", "Choi", "]"}], "]"}]}], "]"}], 
         "\[Transpose]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "evals", "]"}]}], "}"}]}], "]"}]}]}], "\n", 
