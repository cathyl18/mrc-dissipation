 RowBox[{"\n", 
  RowBox[{"(*", " ", 
   RowBox[{"build", " ", "Lindbladian"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ID", " ", "=", " ", 
     RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Jump", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"(", "\[NoBreak]", GridBox[{
         {"1", "0"},
         {"0", 
          RowBox[{"-", "1"}]}
        }], "\[NoBreak]", ")"}], "\[NoBreak]", "}"}]}], ";"}], "\n", 
