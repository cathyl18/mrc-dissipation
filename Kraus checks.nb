Cell[CellGroupData[{
Cell["\<\

My emission channel:\
\>", "Subsection",
 CellChangeTimes->{{3.885641267904416*^9, 
  3.8856412824265003`*^9}},ExpressionUUID->"53810cd2-9a41-41b3-85af-\
35534df615e4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"K0", "[", 
   RowBox[{"ajp_", ",", "aj_", ",", "\[CapitalGamma]_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"KroneckerDelta", "[", 
     RowBox[{"ajp", ",", "0"}], "]"}], " ", 
    RowBox[{"KroneckerDelta", "[", 
     RowBox[{"aj", ",", "0"}], "]"}]}], " ", "+", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"1", "-", "\[CapitalGamma]"}], "]"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"KroneckerDelta", "[", 
       RowBox[{"aj", ",", "ajp"}], "]"}], " ", "-", 
      RowBox[{
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"ajp", ",", "0"}], "]"}], " ", 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"aj", ",", "0"}], "]"}]}]}], 
     ")"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Ki", "[", 
   RowBox[{"ajp_", ",", "aj_", ",", "i_", ",", "\[CapitalGamma]_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Sqrt", "[", "\[CapitalGamma]", "]"}], " ", 
   RowBox[{"KroneckerDelta", "[", 
    RowBox[{"ajp", ",", 
     RowBox[{"i", "-", "1"}]}], "]"}], " ", 
   RowBox[{"KroneckerDelta", "[", 
    RowBox[{"aj", ",", "i"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SigmaTau", "[", 
   RowBox[{"a1_", ",", "b1_", ",", "b2_", ",", "\[Sigma]_"}], "]"}], ":=", 
  " ", 
  RowBox[{
   RowBox[{
    RowBox[{"KroneckerDelta", "[", 
     RowBox[{"\[Sigma]", ",", "1"}], "]"}], 
    RowBox[{"KroneckerDelta", "[", 
     RowBox[{"a1", ",", "b1"}], "]"}]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"KroneckerDelta", "[", 
       RowBox[{"\[Sigma]", ",", "1"}], "]"}]}], ")"}], 
    RowBox[{"KroneckerDelta", "[", 
     RowBox[{"a1", ",", "b2"}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wg", "[", 
   RowBox[{"c_", ",", "\[Tau]_", ",", "q_"}], "]"}], ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"KroneckerDelta", "[", 
     RowBox[{"c", ",", "\[Tau]"}], "]"}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"q", "^", "2"}], "-", "1"}], ")"}]}], " ", "-", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", " ", 
      RowBox[{"KroneckerDelta", "[", 
       RowBox[{"c", ",", "\[Tau]"}], "]"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"q", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"q", "^", "2"}], "-", "1"}], ")"}]}], 
     ")"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"K0K0dag", "[", 
   RowBox[{
   "ajp_", ",", "aj_", ",", "bjp_", ",", "bj_", ",", "\[CapitalGamma]_"}], 
   "]"}], ":=", 
  RowBox[{
   RowBox[{"K0", "[", 
    RowBox[{"ajp", ",", "aj", ",", "\[CapitalGamma]"}], "]"}], "*", 
   RowBox[{"K0", "[", 
    RowBox[{"bj", ",", "bjp", ",", "\[CapitalGamma]"}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"KiKidag", "[", 
   RowBox[{
   "ajp_", ",", "aj_", ",", "bjp_", ",", "bj_", ",", "i_", ",", 
    "\[CapitalGamma]_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Ki", "[", 
    RowBox[{"ajp", ",", "aj", ",", "i", ",", "\[CapitalGamma]"}], "]"}], "*", 
   
   RowBox[{"Ki", "[", 
    RowBox[{"bjp", ",", "bj", ",", "i", ",", "\[CapitalGamma]"}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wd", "[", 
   RowBox[{
   "\[Sigma]_", ",", "\[Tau]_", ",", "q_", ",", "\[CapitalGamma]_", ",", 
    "p_"}], "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"K0K0dag", "[", 
        RowBox[{
        "a0p", ",", "a0", ",", "b0p", ",", "b0", ",", "\[CapitalGamma]"}], 
        "]"}], "+", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"KiKidag", "[", 
          RowBox[{
          "a0p", ",", "a0", ",", "b0p", ",", "b0", ",", "i", ",", 
           "\[CapitalGamma]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", 
           RowBox[{"q", "-", "1"}]}], "}"}]}], "]"}]}], ")"}], "*", 
     RowBox[{"SigmaTau", "[", 
      RowBox[{"a0p", ",", "b0p", ",", "b1p", ",", "\[Sigma]"}], "]"}], "*", 
     RowBox[{"SigmaTau", "[", 
      RowBox[{"a0", ",", "b0", ",", "b1", ",", "\[Tau]"}], "]"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"K0K0dag", "[", 
        RowBox[{
        "a1p", ",", "a1", ",", "b1p", ",", "b1", ",", "\[CapitalGamma]"}], 
        "]"}], "+", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"KiKidag", "[", 
          RowBox[{
          "a1p", ",", "a1", ",", "b1p", ",", "b1", ",", "i", ",", 
           "\[CapitalGamma]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", 
           RowBox[{"q", "-", "1"}]}], "}"}]}], "]"}]}], ")"}], "*", 
     RowBox[{"SigmaTau", "[", 
      RowBox[{"a1p", ",", "b1p", ",", "b0p", ",", "\[Sigma]"}], "]"}], "*", 
     RowBox[{"SigmaTau", "[", 
      RowBox[{"a1", ",", "b1", ",", "b0", ",", "\[Tau]"}], "]"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "p"}], ")"}], "^", "2"}], " ", "+", " ", 
       RowBox[{
        RowBox[{"p", "^", "2"}], " ", "*", 
        RowBox[{"KroneckerDelta", "[", 
         RowBox[{"b0p", ",", "a1p"}], "]"}], 
        RowBox[{"KroneckerDelta", "[", 
         RowBox[{"b0p", ",", "a0p"}], "]"}], 
        RowBox[{"KroneckerDelta", "[", 
         RowBox[{"b1p", ",", "a0p"}], "]"}], 
        RowBox[{"KroneckerDelta", "[", 
         RowBox[{"b1p", ",", "a1p"}], "]"}]}]}], ")"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"a1", ",", "0", ",", 
      RowBox[{"q", "-", "1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"a1p", ",", "0", ",", 
      RowBox[{"q", "-", "1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"b1", ",", "0", ",", 
      RowBox[{"q", "-", "1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"b1p", ",", "0", ",", 
      RowBox[{"q", "-", "1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"a0", ",", "0", ",", 
      RowBox[{"q", "-", "1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"a0p", ",", "0", ",", 
      RowBox[{"q", "-", "1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"b0", ",", "0", ",", 
      RowBox[{"q", "-", "1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"b0p", ",", "0", ",", 
      RowBox[{"q", "-", "1"}]}], "}"}], ",", 
    RowBox[{"Assumptions", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"p", ">", "0"}], ",", 
       RowBox[{"q", ">", "0"}], ",", 
       RowBox[{"Element", "[", 
        RowBox[{"q", ",", "Integers"}], "]"}]}], "}"}]}]}], "]"}]}]}], "Input",\

 CellChangeTimes->{{3.872404630212199*^9, 3.8724046344542837`*^9}, {
