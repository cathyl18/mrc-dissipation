Cell[BoxData[{
 RowBox[{
  RowBox[{"wdtest", "[", 
   RowBox[{
   "\[Sigma]_", ",", "\[Tau]_", ",", "q_", ",", "\[CapitalGamma]_", ",", 
    "p_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Which", " ", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Sigma]", "\[Equal]", "1"}], "&&", 
     RowBox[{"\[Tau]", "\[Equal]", "1"}]}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"1", "/", "2"}], "*", "q", 
         RowBox[{"(", 
          RowBox[{"1", "+", "q"}], ")"}]}], "+", 
        RowBox[{"\[CapitalGamma]", "^", "2"}]}], ")"}], " ", "2", 
      RowBox[{"p", "^", "2"}]}], "-", 
     RowBox[{"2", 
