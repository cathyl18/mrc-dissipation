     RowBox[{"q", "^", "2"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Sigma]", "\[Equal]", 
      RowBox[{"-", "1"}]}], "&&", 
     RowBox[{"\[Tau]", "\[Equal]", 
      RowBox[{"-", "1"}]}]}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "p"}], ")"}], "^", "2"}], 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"2", 
         RowBox[{"(", 
          RowBox[{"q", "-", "1"}], ")"}], 
         RowBox[{"(", 
          RowBox[{"1", "-", "\[CapitalGamma]"}], ")"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"q", "-", "1"}], ")"}], 
         RowBox[{"(", 
          RowBox[{"q", "-", "2"}], ")"}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "\[CapitalGamma]"}], ")"}], "^", "2"}]}], "+", 
