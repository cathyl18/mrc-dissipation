           "\[CapitalGamma]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", 
           RowBox[{"q", "-", "1"}]}], "}"}]}], "]"}]}], ")"}], "*", 
     RowBox[{"SigmaTau", "[", 
      RowBox[{"a1p", ",", "b1p", ",", "b0p", ",", "\[Sigma]"}], "]"}], "*", 
     RowBox[{"SigmaTau", "[", 
      RowBox[{"a1", ",", "b1", ",", "b0", ",", "\[Tau]"}], "]"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "p"}], ")"}], "^", "2"}], " ", "+", " ", 
       RowBox[{
        RowBox[{"p", "^", "2"}], " ", "*", 
        RowBox[{"KroneckerDelta", "[", 
         RowBox[{"b0p", ",", "a1p"}], "]"}], 
        RowBox[{"KroneckerDelta", "[", 
         RowBox[{"b0p", ",", "a0p"}], "]"}], 
        RowBox[{"KroneckerDelta", "[", 
         RowBox[{"b1p", ",", "a0p"}], "]"}], 
