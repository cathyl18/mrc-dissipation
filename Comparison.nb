Cell[TextData[{
 "Now Expand ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["e", 
     RowBox[{
      RowBox[{"-", "\[CapitalGamma]"}], "/", "2"}]], "=", 
    SqrtBox[
     RowBox[{"1", "-", "\[CapitalGamma]"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4d237d37-30e0-460c-b1e5-ef6d19a903be"],
 "and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox[
     RowBox[{"1", "-", 
      SuperscriptBox["e", 
       RowBox[{"-", "\[CapitalGamma]"}]]}]], "=", 
    SqrtBox["\[CapitalGamma]"]}], TraditionalForm]],ExpressionUUID->
  "d5abff80-00e8-408f-9d41-1b6b7d1129cf"],
 ". Notice that these two coefficients are swapped compared to my expression \
so now we swap them:"
}], "Subsection",
 CellChangeTimes->{{3.886501286950694*^9, 
  3.886501398455072*^9}},ExpressionUUID->"9ab51329-68b7-4b26-979e-\
