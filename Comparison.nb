Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"lindbladSpont", " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"J", " ", "=", " ", 
       RowBox[{"(", GridBox[{
          {"0", "0"},
          {"1", "0"}
         }], ")"}]}], 
      RowBox[{"(*", " ", 
       RowBox[{"jump", " ", "operator"}], "*)"}], "}"}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["\[CapitalGamma]", "2"]}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"ID", ",", " ", 
          RowBox[{
           RowBox[{"J", "\[ConjugateTranspose]"}], ".", "J"}]}], "]"}], " ", 
        "+", " ", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"J", "\[ConjugateTranspose]"}], ".", "J"}], ")"}], 
           "\[Transpose]"}], ",", " ", "ID"}], "]"}], " ", "-", " ", 
        RowBox[{"2", " ", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{
           RowBox[{"J", "\[Conjugate]"}], ",", " ", "J"}], "]"}]}]}], 
       ")"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Rho]D", " ", "=", " ", 
   RowBox[{
    RowBox[{"Partition", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"MatrixExp", "[", "lindbladSpont", "]"}], ".", 
       RowBox[{"Flatten", "[", "\[Rho]", "]"}]}], ",", " ", "2"}], "]"}], " ",
     "//", "Expand"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\[Rho]D", " ", "//", "MatrixForm"}], "]"}], ";"}]}], "Code",
 CellChangeTimes->{{3.8855683494247866`*^9, 3.8855684066092405`*^9}, {
   3.885569992756975*^9, 3.885569997531989*^9}, {3.8855700426470556`*^9, 
