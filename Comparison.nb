Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"\[Sigma]", ",", 
    RowBox[{
     RowBox[{"\[Tau]", " ", "tensors", " ", "following", " ", 
      RowBox[{"Yimu", "'"}], "s", " ", 
      RowBox[{"paper", ".", " ", "These"}], " ", "are", " ", "rank"}], "-", 
     RowBox[{"5", " ", "tensors", " ", "for", " ", "two", " ", 
      RowBox[{"replicas", ":", " ", 
       SubscriptBox["\[Sigma]", 
        RowBox[{
        "\[Sigma]", ",", "a1", ",", "b1", ",", "a2", ",", "b2"}]]}]}]}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Sigma]Tensor", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"\[Xi]", " ", "==", " ", "1"}], ",", " ", 
         RowBox[{"DiscreteDelta", "[", 
          RowBox[{
           RowBox[{"a1", "-", "b1"}], ",", " ", 
           RowBox[{"a2", "-", "b2"}]}], "]"}], ",", " ", 
         RowBox[{"DiscreteDelta", "[", 
          RowBox[{
           RowBox[{"a1", "-", "b2"}], ",", " ", 
           RowBox[{"a2", "-", "b1"}]}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\[Xi]", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"a1", ",", "1", ",", "q"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"b1", ",", "1", ",", "q"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"a2", ",", "1", ",", "q"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"b2", ",", "1", ",", "q"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Tau]Tensor", " ", "=", " ", "\[Sigma]Tensor"}], ";"}], "\n", 
   "\n", 
   RowBox[{"(*", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"The", " ", "measurement", " ", "amounts", " ", "to", " ", 
       RowBox[{"contracting", " ", "'"}], 
       RowBox[{"a", "'"}], " ", "indices", " ", 
       RowBox[{"with", " ", "'"}], 
       RowBox[{"b", "'"}], " ", "indices", " ", "of", " ", "neighboring", " ", 
       RowBox[{"replicas", ".", " ", "This"}], " ", "is", " ", 
       RowBox[{"Eq", ".", " ", "A4"}], " ", "from", " ", "Yimu", " ", 
       RowBox[{"Bao", "'"}], "s", " ", 
       RowBox[{"paper", ".", "\n", "  ", "The"}], " ", "measurement", " ", 
       "tensor", " ", "is", " ", "a", " ", "rank"}], "-", 
      RowBox[{"8", " ", "tensor"}]}], ",", " ", 
     RowBox[{"with", " ", "ingoing", " ", "indices", " ", "a1"}], ",", "b1", 
     ",", "a2", ",", 
     RowBox[{"b2", " ", "and", " ", "outgoing", " ", "indices", " ", "A1"}], 
     ",", "B1", ",", "A2", ",", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"B2", ".", "\n", "  ", "This"}], " ", "could", " ", "have", 
         " ", "been", " ", "simplified"}], "..."}], " ", "the", " ", 
       "entries", " ", "are", " ", "nonzero", " ", "only", " ", "if", " ", 
       "the", " ", "outgoing", " ", "indices", " ", "match", " ", "ingoing", 
       " ", "indices", " ", "a1"}], "=", "A1"}], ",", 
     RowBox[{"a2", "=", "A2"}], ",", "..."}], "\n", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Measurement", " ", "=", " ", 
     RowBox[{
      RowBox[{"Table", "[", "\n", "\t\t\t\t", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"Cos", "[", "\[Alpha]", "]"}], "4"], " ", "+", " ", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"Sin", "[", "\[Alpha]", "]"}], "4"], " ", 
            RowBox[{"DiscreteDelta", "[", 
             RowBox[{
              RowBox[{"a1", "-", "b1"}], ",", " ", 
              RowBox[{"b1", "-", "a2"}], ",", " ", 
              RowBox[{"a2", "-", "b2"}], ",", " ", 
              RowBox[{"b2", "-", "a1"}]}], "]"}]}]}], ")"}], " ", "*", " ", 
         RowBox[{"DiscreteDelta", "[", 
          RowBox[{
           RowBox[{"a1", "-", "A1"}], ",", 
           RowBox[{"b1", "-", "B1"}], ",", 
           RowBox[{"a2", "-", "A2"}], ",", 
           RowBox[{"b2", "-", "B2"}]}], "]"}]}], "\n", "\t\t\t", ",", " ", 
        RowBox[{"{", 
         RowBox[{"a1", ",", "1", ",", "q"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"b1", ",", "1", ",", "q"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"a2", ",", "1", ",", "q"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"b2", ",", "1", ",", "q"}], "}"}], "\n", "\t\t\t", ",", " ", 
        
        RowBox[{"{", 
         RowBox[{"A1", ",", "1", ",", "q"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"B1", ",", "1", ",", "q"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"A2", ",", "1", ",", "q"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"B2", ",", "1", ",", "q"}], "}"}]}], "\n", "\t\t\t", "]"}], 
      " ", "//", "Simplify"}]}], ";"}]}]}]], "Code",
