Cell[BoxData[
 RowBox[{
  FractionBox["1", 
   RowBox[{
    RowBox[{"-", "1"}], "+", 
    SuperscriptBox["q", "4"]}]], 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"2", " ", "p"}], "+", 
        RowBox[{"2", " ", 
         SuperscriptBox["p", "2"]}]}], ")"}], "2"], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "\[CapitalGamma]"}], ")"}], "2"], "-", 
        FractionBox[
         RowBox[{"q", " ", 
          SuperscriptBox["\[CapitalGamma]", "2"]}], 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          SuperscriptBox["q", "2"]}]]}], ")"}], "2"]}], "-", 
    RowBox[{
     SuperscriptBox["q", "2"], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["p", "2"], "+", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "1"}], "+", "p"}], ")"}], "2"], " ", "q"}]}], 
          ")"}], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "\[CapitalGamma]"}], ")"}], "2"]}], "+", 
        
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"2", " ", "p"}], "+", 
            RowBox[{"2", " ", 
             SuperscriptBox["p", "2"]}]}], ")"}], " ", "q", " ", 
          SuperscriptBox["\[CapitalGamma]", "2"]}], 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          SuperscriptBox["q", "2"]}]]}], ")"}], "2"]}], "-", 
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"2", " ", "p"}], "+", 
           RowBox[{"2", " ", 
