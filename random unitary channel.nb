Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"w3", "[", 
    RowBox[{
    "1", ",", "1", ",", "1", ",", "q", ",", "p", ",", "\[CapitalGamma]"}], 
    "]"}], "-", 
   RowBox[{"w3", "[", 
    RowBox[{
     RowBox[{"-", "1"}], ",", 
     RowBox[{"-", "1"}], ",", 
     RowBox[{"-", "1"}], ",", "q", ",", "p", ",", "\[CapitalGamma]"}], 
