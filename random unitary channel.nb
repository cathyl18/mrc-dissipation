     SuperscriptBox["q", "2"], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", "\[CapitalGamma]"}], ")"}], "2"], " ", 
     SuperscriptBox["\[CapitalGamma]", "2"]}], "-", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", "p"}], ")"}], "4"], " ", 
     SuperscriptBox["q", "2"], " ", 
     SuperscriptBox["\[CapitalGamma]", "4"]}]}]}]],
  CellChangeTimes->{3.8701432669002457`*^9, 3.8701703717112417`*^9, 
   3.870172159351914*^9, 3.870813405596827*^9, 3.870815598821772*^9},
  ExpressionUUID->"b1701a76-1599-4d56-a3eb-35a8f6b8bd27"],
 "\n",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["q", "4"], "-", "1"}], ")"}], 
     SuperscriptBox["w", 
      RowBox[{"(", "3", ")"}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1", ",", "1"}], ")"}]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["q", "4"], "-", "1"}], ")"}], 
      SuperscriptBox["w", 
       RowBox[{"(", "3", ")"}]], 
      RowBox[{"(", 
       RowBox[{"1", ",", 
        RowBox[{"-", "1"}], ",", "1"}], ")"}]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", "p"}], ")"}], "4"], " ", 
        SuperscriptBox["q", "3"], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", "\[CapitalGamma]"}], ")"}], "4"]}], "+", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", "p"}], ")"}], "2"], " ", 
        SuperscriptBox["p", "2"], " ", 
        SuperscriptBox["q", "3"], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", "\[CapitalGamma]"}], ")"}], "4"]}], " ", "+", 
       FractionBox[
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"1", "-", "p"}], ")"}], "4"], " ", 
         SuperscriptBox["q", "5"], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"1", "-", "\[CapitalGamma]"}], ")"}], "2"], " ", 
         SuperscriptBox["\[CapitalGamma]", "2"]}], 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SuperscriptBox["q", "2"]}]]}], "=", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", "p"}], ")"}], "4"], " ", 
        SuperscriptBox["q", "3"], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", "\[CapitalGamma]"}], ")"}], "4"]}], "+", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", "p"}], ")"}], "2"], " ", 
        SuperscriptBox["p", "2"], " ", 
        SuperscriptBox["q", "3"], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", "\[CapitalGamma]"}], ")"}], "4"]}], "+", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", "p"}], ")"}], "4"], " ", 
        SuperscriptBox["q", "3"], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", "\[CapitalGamma]"}], ")"}], "2"], " ", 
        SuperscriptBox["\[CapitalGamma]", "2"]}], "+", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", "p"}], ")"}], "2"], " ", 
        SuperscriptBox["p", "2"], " ", 
        SuperscriptBox["q", "3"], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", "\[CapitalGamma]"}], ")"}], "2"], " ", 
        SuperscriptBox["\[CapitalGamma]", "2"]}]}]}]}]}], ","}]],
  ExpressionUUID->"670251e8-af60-4168-ab81-ea718a8e0f66"],
 " \n",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["q", "4"], "-", "1"}], ")"}], 
    SuperscriptBox["w", 
     RowBox[{"(", "3", ")"}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], ",", "1", ",", 
      RowBox[{"-", "1"}]}], ")"}]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["q", "4"], "-", "1"}], ")"}], 
     SuperscriptBox["w", 
      RowBox[{"(", "3", ")"}]], 
     RowBox[{"(", 
      RowBox[{"1", ",", 
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", "1"}]}], ")"}]}], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", "p"}], ")"}], "4"], " ", 
      SuperscriptBox["q", "3"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", "\[CapitalGamma]"}], ")"}], "4"]}], "+", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", "p"}], ")"}], "2"], " ", 
      SuperscriptBox["p", "2"], " ", 
      SuperscriptBox["q", "3"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", "\[CapitalGamma]"}], ")"}], "4"]}]}]}]}]],
  ExpressionUUID->"15946558-69d7-42e6-96e4-27b729786d4b"],
 ".\nNow use the same trick as the other dissipative channel, which is to \
expand to the next highest order in the weights for all up and all down spin \
configuration, and try to set them to equal. This ensures the ground state \
degeneracy, and offers possibly a critical probability as a function of the \
dissipation rate. However, this seems to yield only p=1 as the critical \
measurement rate."
}], "Text",
