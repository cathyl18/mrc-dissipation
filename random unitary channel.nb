Cell[BoxData[{
 RowBox[{"NSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"4", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", "p"}], ")"}], "2"], " ", 
        SuperscriptBox["p", "2"], " ", 
        SuperscriptBox["q", "5"], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", "\[CapitalGamma]"}], ")"}], "2"], " ", 
        SuperscriptBox["\[CapitalGamma]", "2"]}], 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["q", "2"]}]], "+", 
      FractionBox[
       RowBox[{"2", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", "p"}], ")"}], "4"], " ", 
        SuperscriptBox["q", "6"], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", "\[CapitalGamma]"}], ")"}], "2"], " ", 
        SuperscriptBox["\[CapitalGamma]", "2"]}], 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["q", "2"]}]], "+", 
      FractionBox[
       RowBox[{"2", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", "p"}], ")"}], "2"], " ", 
        SuperscriptBox["p", "2"], " ", 
        SuperscriptBox["q", "7"], " ", 
        SuperscriptBox["\[CapitalGamma]", "4"]}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          SuperscriptBox["q", "2"]}], ")"}], "2"]], "+", 
      FractionBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", "p"}], ")"}], "4"], " ", 
        SuperscriptBox["q", "8"], " ", 
        SuperscriptBox["\[CapitalGamma]", "4"]}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          SuperscriptBox["q", "2"]}], ")"}], "2"]]}], " ", "\[Equal]", "0"}], 
    "/.", 
    RowBox[{"{", 
     RowBox[{"q", "\[Rule]", "10"}], "}"}]}], ",", "p"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NSolve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"w3", "[", 
        RowBox[{
        "1", ",", "1", ",", "1", ",", "q", ",", "p", ",", "\[CapitalGamma]"}],
         "]"}], "-", 
       RowBox[{"w3", "[", 
        RowBox[{
         RowBox[{"-", "1"}], ",", 
         RowBox[{"-", "1"}], ",", 
         RowBox[{"-", "1"}], ",", "q", ",", "p", ",", "\[CapitalGamma]"}], 
        "]"}]}], "\[Equal]", "0"}], "/.", 
     RowBox[{"{", 
      RowBox[{"q", "\[Rule]", "10"}], "}"}]}], ",", "p"}], "]"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.8701434135897093`*^9, 3.8701434246040792`*^9}, {
   3.870143825445653*^9, 3.870143882385624*^9}, {3.870144041708681*^9, 
   3.870144081485303*^9}, {3.870144127481311*^9, 3.8701442762563047`*^9}, {
