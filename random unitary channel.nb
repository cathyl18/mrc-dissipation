Cell[TextData[{
 "It\[CloseCurlyQuote]s pretty clear the leading term in both cases has ",
 Cell[BoxData[
  SuperscriptBox["q", "4"]],
  CellChangeTimes->{3.870140186227096*^9, 3.870140216525745*^9, 
   3.87014024898347*^9, 3.870141389558325*^9},ExpressionUUID->
  "49d7ef8f-5bff-4088-b35e-e2363c2880da"],
 " power, but  ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["q", "4"], "-", "1"}], ")"}], 
    SuperscriptBox["w", 
     RowBox[{"(", "3", ")"}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"+", "1"}], ",", 
      RowBox[{"+", "1"}], ",", 
      RowBox[{"+", "1"}]}], ")"}]}], "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", "p"}], ")"}], "4"], " ", 
     SuperscriptBox["q", "4"], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", "\[CapitalGamma]"}], ")"}], "4"]}], "+", 
    FractionBox[
     RowBox[{"2", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", "p"}], ")"}], "4"], " ", 
      SuperscriptBox["q", "6"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", "\[CapitalGamma]"}], ")"}], "2"], " ", 
      SuperscriptBox["\[CapitalGamma]", "2"]}], 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      SuperscriptBox["q", "2"]}]], "+", 
    FractionBox[
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", "p"}], ")"}], "4"], " ", 
      SuperscriptBox["q", "8"], " ", 
      SuperscriptBox["\[CapitalGamma]", "4"]}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["q", "2"]}], ")"}], "2"]]}]}]],ExpressionUUID->
  "993c4967-9fd6-4f5a-a119-910ed7d44109"],
 ", whereas ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["q", "4"], "-", "1"}], ")"}], 
    SuperscriptBox["w", 
     RowBox[{"(", "3", ")"}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "1"}]}], ")"}]}], "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "-", "p"}], ")"}], "4"], " ", 
    SuperscriptBox["q", "4"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "-", "\[CapitalGamma]"}], ")"}], "4"]}]}]],ExpressionUUID->
  "a4a0f413-a8c2-49eb-8bfc-94647669ea95"],
 ".\n Just like the previous the previous dissipation we considered, the \
dissipative term is the symmetry breaking term.\n\nApplying the same to other \
weights,  we gather all the results here,\n",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["q", "4"], "-", "1"}], ")"}], 
     SuperscriptBox["w", 
      RowBox[{"(", "3", ")"}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", "1"}], ",", "1"}], ")"}]}], "=", 
    RowBox[{
     RowBox[{"2", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", "p"}], ")"}], "2"], " ", 
      SuperscriptBox["p", "2"], " ", 
      SuperscriptBox["q", "2"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", "\[CapitalGamma]"}], ")"}], "4"]}], "+", 
     RowBox[{
      SuperscriptBox["p", "4"], " ", 
      SuperscriptBox["q", "2"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", "\[CapitalGamma]"}], ")"}], "4"]}]}]}], ","}]],
  ExpressionUUID->"7184c14e-7dbc-47d3-b7fe-8c6a509396a8"],
 "\n",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["q", "4"], "-", "1"}], ")"}], 
    SuperscriptBox["w", 
     RowBox[{"(", "3", ")"}]], 
    RowBox[{"(", 
     RowBox[{"1", ",", "1", ",", 
      RowBox[{"-", "1"}]}], ")"}]}], "="}]],ExpressionUUID->
  "c5c618f2-0781-49b3-b81a-c854a56ceeaa"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"2", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", "p"}], ")"}], "2"], " ", 
     SuperscriptBox["p", "2"], " ", 
     SuperscriptBox["q", "2"], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", "\[CapitalGamma]"}], ")"}], "4"]}], "+", 
