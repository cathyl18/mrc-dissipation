     SuperscriptBox["q", "2"], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", "\[CapitalGamma]"}], ")"}], "4"]}], "+", 
    RowBox[{
     SuperscriptBox["p", "4"], " ", 
     SuperscriptBox["q", "2"], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", "\[CapitalGamma]"}], ")"}], "4"]}], "-", 
