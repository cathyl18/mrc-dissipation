Notebook[{

Cell[CellGroupData[{
Cell["Boltzmann weights for the random unitary channel", "Section",
 CellChangeTimes->{{3.870131716600833*^9, 3.870131754949649*^9}, {
  3.870131944177163*^9, 
  3.870132001270028*^9}},ExpressionUUID->"6447de6b-d991-424c-85b1-\
7f7ddecd047e"],

Cell[TextData[{
 "Minimal setup: the 2nd Renyi entropy in the n=2, q -> \[Infinity]  limit \
corresponds to the partition function of the 2D Ising model (\[Sigma] = 0,1) \
on a honeycomb lattice with diagonal bonds ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "d"], TraditionalForm]],ExpressionUUID->
  "7ce5edf1-334a-4ea5-9f70-bacc96c5ce9f"],
 " and vertical bond ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["w", "g"], "."}], TraditionalForm]],ExpressionUUID->
  "95647246-101a-481b-8b70-6522be94c006"],
 " Integrating out the top spin value on the vertical bonds gives an Ising \
model on a triangular lattice with diagonal bonds and horizontal bonds, or \
equivalently one can think of it as weights defined on the inverted triangles \
with spins on each vertex ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "1"], TraditionalForm]],ExpressionUUID->
  "4f28e227-caa3-457a-92ca-af6df0d7e793"],
 " (left), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", 
     RowBox[{"2", " "}]], "(", "right", ")"}], TraditionalForm]],
  ExpressionUUID->"9e10d82d-1b3d-43e2-9a55-900175b1793f"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "3"], TraditionalForm]],ExpressionUUID->
  "75c646cf-126b-4a64-b4fa-a0a4745d0590"],
 " (bottom)."
}], "Text",
 CellChangeTimes->{{3.8701320256069183`*^9, 
  3.870132473163035*^9}},ExpressionUUID->"4ed717b4-364c-4f6a-8fb2-\
51fa06eae493"],

Cell[CellGroupData[{

Cell["The 3-body Boltzmann weight ", "Subsection",
 CellChangeTimes->{{3.870132478054098*^9, 3.87013255696421*^9}, {
  3.870135401468062*^9, 
  3.870135403739904*^9}},ExpressionUUID->"52fa3d6d-eb73-454e-8af1-\
55fadc15ea7c"],

Cell[TextData[{
 "The Weingarten function is on the 2-Unitary is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["w", "g"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Sigma]", "3"], 
       SuperscriptBox["\[Tau]", 
        RowBox[{"-", "1"}]]}], ",", "q"}], ")"}]}], "=", 
   RowBox[{
    FractionBox[
     SubscriptBox["\[Delta]", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Sigma]", "3"], 
        SuperscriptBox["\[Tau]", 
         RowBox[{"-", "1"}]]}], ",", "0"}]], 
     RowBox[{
      SuperscriptBox["q", "2"], "-", "1"}]], "-", 
    FractionBox[
     SubscriptBox["\[Delta]", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Sigma]", "3"], 
        SuperscriptBox["\[Tau]", 
         RowBox[{"-", "1"}]]}], ",", "1"}]], 
     RowBox[{"q", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["q", "2"], "-", "1"}], ")"}]}]]}]}]],ExpressionUUID->
  "6ea465b7-82bb-4db0-864c-3964b2e4097c"],
 ". For the n=2 case, ",
 Cell[BoxData[
  SubscriptBox["\[Delta]", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Sigma]", "3"], 
     SuperscriptBox["\[Tau]", 
      RowBox[{"-", "1"}]]}], ",", "1"}]]],ExpressionUUID->
  "08ca1441-f45b-4cbc-97b9-e60d9845cd21"],
 " can be subbed by ",
 Cell[BoxData[
  SubscriptBox["\[Delta]", 
   RowBox[{
    SubscriptBox["\[Sigma]", "3"], ",", "\[Tau]"}]]],ExpressionUUID->
  "955df796-22dc-44bb-8851-a26ab498ec34"],
 " and ",
 Cell[BoxData[
  SubscriptBox["\[Delta]", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Sigma]", "3"], 
     SuperscriptBox["\[Tau]", 
      RowBox[{"-", "1"}]]}], ",", 
    RowBox[{"-", "1"}]}]]],ExpressionUUID->
  "076dbe1c-c8b6-458e-9600-320b1f916718"],
 " by  ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   SubscriptBox["\[Delta]", 
    RowBox[{
     SubscriptBox["\[Sigma]", "3"], ",", "\[Tau]"}]]}]],ExpressionUUID->
  "c7f111d4-306b-49ef-ae2d-4551554ec616"],
 ". The Weingarten function will enter the diagonal bond weight as well: ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["w", "d"], 
    RowBox[{"(", 
     RowBox[{
     "\[Sigma]", ",", "\[Tau]", ",", "q", ",", "p", ",", "\[CapitalGamma]"}], 
     ")"}]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["q", 
         RowBox[{"|", 
          SuperscriptBox["\[Sigma]\[Tau]", 
           RowBox[{"-", "1"}]], "|"}]], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", "p"}], ")"}], "2"]}], "+", 
       SuperscriptBox["qp", "2"]}], ")"}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", "\[CapitalGamma]"}], ")"}], "2"]}], " ", "+", 
    RowBox[{
     SubscriptBox["w", "g"], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[Sigma]\[Tau]", 
        RowBox[{"-", "1"}]], ",", "q"}], ")"}], 
     SuperscriptBox["q", 
      RowBox[{"|", "\[Tau]", "|", 
       RowBox[{"+", "1"}]}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["q", 
         RowBox[{"|", "\[Sigma]", "|", 
          RowBox[{"-", "1"}]}]], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", "p"}], ")"}], "2"]}], "+", 
       SuperscriptBox["p", "2"]}], ")"}], 
     SuperscriptBox["\[CapitalGamma]", "2"]}]}]}]],ExpressionUUID->
  "9e18e03c-8282-4132-970b-209d60887459"],
 ", where q is the local Hilbert space dimension, p is the probability of \
measurement,  \[CapitalGamma] is the dissipation rate, |\[CenterDot]| is the \
number of cycles of the element, which will be 1 when the argument is \
transposition (denoted as -1) and 2 when the argument is the identity \
(denoted as +1).\nIn the following cell, we assume that "
}], "Text",
 CellChangeTimes->{{3.870135412312451*^9, 3.870135438883214*^9}, {
   3.870135474314528*^9, 3.870135475891139*^9}, {3.870135574558257*^9, 
   3.870135583127166*^9}, {3.870135679765291*^9, 3.870135679765324*^9}, {
   3.870136710112835*^9, 3.8701369209278603`*^9}, {3.870136953894261*^9, 
   3.870137016908778*^9}, {3.870137049537929*^9, 3.870137298051468*^9}, {
   3.8701373501554813`*^9, 3.87013735465171*^9}, {3.8701373879589148`*^9, 
   3.870137404423647*^9}, {3.8701374548901663`*^9, 3.8701376062711773`*^9}, {
   3.8701376409755297`*^9, 3.8701377998732653`*^9}, 3.8701378543539333`*^9, {
   3.870137911748226*^9, 3.870138024150447*^9}, 3.87013809434548*^9, {
   3.870138256010673*^9, 3.870138260219277*^9}, {3.8701383440228024`*^9, 
   3.8701383468178663`*^9}, {3.8701383774783487`*^9, 
   3.8701384730347843`*^9}, {3.870138509261372*^9, 3.870138521848609*^9}, {
   3.870813775176874*^9, 
   3.870813775264435*^9}},ExpressionUUID->"911c75b7-c925-473e-8a2b-\
6da02062409f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"wg", "[", 
    RowBox[{"c_", ",", "\[Tau]_", ",", "q_"}], "]"}], ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"KroneckerDelta", "[", 
      RowBox[{"c", ",", "\[Tau]"}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"q", "^", "2"}], "-", "1"}], ")"}]}], " ", "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", " ", 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"c", ",", "\[Tau]"}], "]"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"q", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"q", "^", "2"}], "-", "1"}], ")"}]}], " ", ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wd", "[", 
   RowBox[{
   "a_", ",", "\[Tau]_", ",", "q_", ",", "p_", ",", "\[CapitalGamma]_"}], 
   "]"}], ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"q", "^", "2"}], " ", "*", 
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"a", ",", "\[Tau]"}], "]"}]}], "+", 
         RowBox[{"q", " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"KroneckerDelta", "[", 
             RowBox[{"a", ",", "\[Tau]"}], "]"}]}], ")"}]}]}], ")"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "p"}], ")"}], "^", "2"}]}], "+", 
      RowBox[{"q", " ", 
       RowBox[{"p", "^", "2"}]}]}], ")"}], " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "\[CapitalGamma]"}], ")"}], "^", "2"}]}], " ", "+", 
   " ", 
   RowBox[{
    RowBox[{"wg", "[", 
     RowBox[{"a", ",", "\[Tau]", ",", "q"}], "]"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"q", "^", "3"}], " ", "*", 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"\[Tau]", ",", "1"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"q", "^", "2"}], " ", "*", 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"\[Tau]", ",", 
         RowBox[{"-", "1"}]}], "]"}]}]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"q", " ", 
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"a", ",", "1"}], "]"}]}], "+", " ", 
         RowBox[{"KroneckerDelta", "[", 
          RowBox[{"a", ",", 
           RowBox[{"-", "1"}]}], "]"}]}], ")"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "p"}], ")"}], "^", "2"}]}], " ", "+", " ", 
      RowBox[{"p", "^", "2"}]}], ")"}], " ", 
    RowBox[{"\[CapitalGamma]", "^", "2"}]}]}]}]}], "Input",
 CellChangeTimes->{{3.8701354796438093`*^9, 3.870135509424162*^9}, {
   3.870135551582345*^9, 3.870135572298065*^9}, {3.8701378769851637`*^9, 
   3.870137897438066*^9}, {3.870138872543738*^9, 3.87013888730722*^9}, {
   3.870141249136445*^9, 3.870141263656681*^9}, 3.87014132106922*^9, {
   3.870811070375423*^9, 3.870811102255434*^9}, {3.870813772804327*^9, 
   3.870813772860955*^9}, {3.870819001426972*^9, 3.870819007062669*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"c442e6d7-2f6d-431e-9c17-4ca5bd77674f"],

Cell[TextData[{
 " The three body weight is then ",
 Cell[BoxData[GridBox[{
    {
     RowBox[{
      RowBox[{
       SuperscriptBox["w", 
        RowBox[{"(", "3", ")"}]], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[Sigma]", "1"], ",", 
         SubscriptBox["\[Sigma]", "2"], ",", 
         SubscriptBox["\[Sigma]", "3"], ",", "q", ",", "p"}], ")"}]}], "=", 
      SubscriptBox["\[Sum]", "\[Tau]"]}], 
     RowBox[{
      SubscriptBox["w", "d"], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Sigma]", "1"], ",", "\[Tau]", ",", "q", ",", "p", ",",
         "\[CapitalGamma]"}], ")"}], 
      SubscriptBox["w", "d"], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Sigma]", "2"], ",", "\[Tau]", ",", "q", ",", "p", ",",
         "\[CapitalGamma]"}], ")"}], 
      SubscriptBox["w", "g"], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Sigma]", "3"], 
         SuperscriptBox["\[Tau]", 
          RowBox[{"-", "1"}]]}], ",", 
        SuperscriptBox["q", "2"]}], ")"}]}]}
   }]],ExpressionUUID->"4c9e8dbb-3322-4f02-9e69-c82eb91d4b14"],
 ". "
}], "Text",
 CellChangeTimes->{{3.870138101182315*^9, 3.8701381042178288`*^9}, {
  3.870138240706443*^9, 
  3.87013825485928*^9}},ExpressionUUID->"2487d110-3ed9-4b3c-834a-\
f2a2206bbdee"],

Cell[BoxData[
 RowBox[{
  RowBox[{"w3", "[", 
   RowBox[{
   "a_", ",", "b_", ",", "c_", ",", "q_", ",", "p_", ",", 
    "\[CapitalGamma]_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"wd", "[", 
     RowBox[{"a", ",", "1", ",", "q", ",", "p", ",", "\[CapitalGamma]"}], 
     "]"}], " ", 
    RowBox[{"wd", "[", 
     RowBox[{"b", ",", "1", ",", "q", ",", "p", ",", "\[CapitalGamma]"}], 
     "]"}], 
    RowBox[{"wg", "[", 
     RowBox[{"c", ",", "1", ",", 
      RowBox[{"q", "^", "2"}]}], "]"}]}], "+", 
   RowBox[{
    RowBox[{"wd", "[", 
     RowBox[{"a", ",", 
      RowBox[{"-", "1"}], ",", "q", ",", "p", ",", "\[CapitalGamma]"}], "]"}],
     " ", 
    RowBox[{"wd", "[", 
     RowBox[{"b", ",", 
      RowBox[{"-", "1"}], ",", "q", ",", "p", ",", "\[CapitalGamma]"}], "]"}], 
    RowBox[{"wg", "[", 
     RowBox[{"c", ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"q", "^", "2"}]}], "]"}]}]}]}]], "Input",
