  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wLegend", "=", 
   RowBox[{"MaTeX", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\"\<w^{(2)}(\\\\uparrow \\\\uparrow \\\\uparrow)\>\"", ",", 
       "\"\<w^{(2)}(\\\\uparrow \\\\uparrow \\\\downarrow)\>\"", ",", 
       "\"\<w^{(2)}(\\\\uparrow \\\\downarrow \\\\uparrow)\>\"", ",", 
       "\"\<w^{(2)}(\\\\downarrow \\\\uparrow \\\\uparrow)\>\"", ",", 
       "\"\<w^{(2)}(\\\\downarrow \\\\uparrow \\\\downarrow)\>\"", ",", 
