   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", " ", 
      RowBox[{"KroneckerDelta", "[", 
       RowBox[{"c", ",", "\[Tau]"}], "]"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"q", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"q", "^", "2"}], "-", "1"}], ")"}]}], ")"}]}]}]}]}], "Input",
 CellChangeTimes->{{3.8855886430634117`*^9, 3.885588679050685*^9}, {
