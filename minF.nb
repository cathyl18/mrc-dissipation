  " ", 
  RowBox[{
   RowBox[{
    RowBox[{"KroneckerDelta", "[", 
     RowBox[{"\[Sigma]", ",", "1"}], "]"}], 
    RowBox[{"KroneckerDelta", "[", 
     RowBox[{"a1", ",", "b1"}], "]"}]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"KroneckerDelta", "[", 
       RowBox[{"\[Sigma]", ",", "1"}], "]"}]}], ")"}], 
    RowBox[{"KroneckerDelta", "[", 
     RowBox[{"a1", ",", "b2"}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wg", "[", 
