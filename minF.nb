Cell[BoxData[{
 RowBox[{
  RowBox[{"wdtest", "[", 
   RowBox[{
   "\[Sigma]_", ",", "\[Tau]_", ",", "q_", ",", "\[CapitalGamma]_", ",", 
    "p_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Which", " ", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Sigma]", "\[Equal]", "1"}], "&&", 
     RowBox[{"\[Tau]", "\[Equal]", "1"}]}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"1", "/", "2"}], "*", "q", 
         RowBox[{"(", 
          RowBox[{"1", "+", "q"}], ")"}]}], "+", 
        RowBox[{"\[CapitalGamma]", "^", "2"}]}], ")"}], " ", "2", 
      RowBox[{"p", "^", "2"}]}], "-", 
     RowBox[{"2", 
      RowBox[{"q", "^", "2"}], "  ", "p"}], " ", "+", " ", 
     RowBox[{"q", "^", "2"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Sigma]", "\[Equal]", 
      RowBox[{"-", "1"}]}], "&&", 
     RowBox[{"\[Tau]", "\[Equal]", 
      RowBox[{"-", "1"}]}]}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "p"}], ")"}], "^", "2"}], 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"2", 
         RowBox[{"(", 
          RowBox[{"q", "-", "1"}], ")"}], 
         RowBox[{"(", 
          RowBox[{"1", "-", "\[CapitalGamma]"}], ")"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"q", "-", "1"}], ")"}], 
         RowBox[{"(", 
          RowBox[{"q", "-", "2"}], ")"}], 
