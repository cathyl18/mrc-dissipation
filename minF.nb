       "\"\<w^{(2)}(\\\\downarrow \\\\downarrow \\\\uparrow)\>\"", ",", 
       "\"\<w^{(2)}(\\\\downarrow \\\\downarrow \\\\downarrow)\>\""}], "}"}], 
     ",", 
     RowBox[{"Magnification", "\[Rule]", "1.5"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"boltzmann3", " ", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Log", "[", 
        RowBox[{"{", 
         RowBox[{
         "w000", ",", "w001", ",", "w010", ",", "w100", ",", "w101", ",", 
          "w011", ",", "w110", ",", "w111"}], "}"}], "]"}]}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"q", "\[Rule]", "2"}], ",", 
        RowBox[{"\[CapitalGamma]", "\[Rule]", "0.1"}]}], "}"}]}], "]"}], ",", 
    
    RowBox[{"{", 
     RowBox[{"p", ",", "0", ",", "1"}], "}"}], ",", 
    RowBox[{"PlotLegends", "\[Rule]", 
     RowBox[{"LineLegend", "[", 
      RowBox[{"Automatic", ",", "wLegend", ",", 
       RowBox[{"Spacings", "\[Rule]", "0.15"}]}], "]"}]}], ",", 
    RowBox[{"AxesLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<p\>\"", ",", "\"\<Energy\>\""}], "}"}]}], ",", 
    RowBox[{"LabelStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"FontSize", "\[Rule]", "22"}], "}"}]}], ",", 
    RowBox[{"PlotRange", "\[Rule]", "Automatic"}], ",", " ", 
    RowBox[{"PlotStyle", "\[Rule]", "dashThick"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
