Cell[BoxData[
 TagBox[
  FractionBox[
   RowBox[{
    SuperscriptBox["2", 
     RowBox[{"-", "n"}]], " ", 
    SqrtBox["\[Pi]"], " ", 
    RowBox[{"Binomial", "[", 
     RowBox[{"n", ",", 
      FractionBox["n", "2"]}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"1", "+", 
      RowBox[{"2", " ", "n"}]}], "]"}]}], 
   RowBox[{
    RowBox[{"Gamma", "[", 
     FractionBox[
      RowBox[{"1", "+", "n"}], "2"], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"2", "+", 
        RowBox[{"3", " ", "n"}]}], ")"}]}], "]"}]}]],
