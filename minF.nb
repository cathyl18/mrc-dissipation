Cell[BoxData[{
 RowBox[{
  RowBox[{"K0", "[", 
   RowBox[{"ajp_", ",", "aj_", ",", "\[CapitalGamma]_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"KroneckerDelta", "[", 
     RowBox[{"ajp", ",", "0"}], "]"}], " ", 
    RowBox[{"KroneckerDelta", "[", 
     RowBox[{"aj", ",", "0"}], "]"}]}], " ", "+", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"1", "-", "\[CapitalGamma]"}], "]"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"KroneckerDelta", "[", 
       RowBox[{"aj", ",", "ajp"}], "]"}], " ", "-", 
      RowBox[{
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"ajp", ",", "0"}], "]"}], " ", 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"aj", ",", "0"}], "]"}]}]}], 
     ")"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Ki", "[", 
   RowBox[{"ajp_", ",", "aj_", ",", "i_", ",", "\[CapitalGamma]_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Sqrt", "[", "\[CapitalGamma]", "]"}], " ", 
   RowBox[{"KroneckerDelta", "[", 
    RowBox[{"ajp", ",", 
     RowBox[{"i", "-", "1"}]}], "]"}], " ", 
   RowBox[{"KroneckerDelta", "[", 
    RowBox[{"aj", ",", "i"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SigmaTau", "[", 
   RowBox[{"a1_", ",", "b1_", ",", "b2_", ",", "\[Sigma]_"}], "]"}], ":=", 
  " ", 
  RowBox[{
   RowBox[{
    RowBox[{"KroneckerDelta", "[", 
     RowBox[{"\[Sigma]", ",", "1"}], "]"}], 
    RowBox[{"KroneckerDelta", "[", 
     RowBox[{"a1", ",", "b1"}], "]"}]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"KroneckerDelta", "[", 
       RowBox[{"\[Sigma]", ",", "1"}], "]"}]}], ")"}], 
    RowBox[{"KroneckerDelta", "[", 
     RowBox[{"a1", ",", "b2"}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wg", "[", 
   RowBox[{"c_", ",", "\[Tau]_", ",", "q_"}], "]"}], ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"KroneckerDelta", "[", 
     RowBox[{"c", ",", "\[Tau]"}], "]"}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"q", "^", "2"}], "-", "1"}], ")"}]}], " ", "-", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", " ", 
      RowBox[{"KroneckerDelta", "[", 
       RowBox[{"c", ",", "\[Tau]"}], "]"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"q", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"q", "^", "2"}], "-", "1"}], ")"}]}], ")"}]}]}]}]}], "Input",
 CellChangeTimes->{{3.872404630212199*^9, 3.8724046344542837`*^9}, {
   3.8724046688724327`*^9, 3.872404960434554*^9}, {3.8724051081019278`*^9, 
