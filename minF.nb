Cell[BoxData[{
 RowBox[{"Clear", "[", "n", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Sum", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Binomial", "[", 
     RowBox[{"n", ",", "y"}], "]"}], "*", 
    RowBox[{"Binomial", "[", 
     RowBox[{"n", ",", 
      RowBox[{
       RowBox[{"n", "/", "2"}], "-", "y"}]}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", "0", ",", "n"}], "}"}]}], "]"}]}], "Input",
