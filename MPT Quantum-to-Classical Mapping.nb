  RowBox[{"(*", " ", 
   RowBox[{"Lindbladian", " ", "with", " ", "single", " ", 
    SubscriptBox["\[Sigma]", "z"], " ", "jump", " ", "operator"}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"lindbladZ", " ", "=", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"J", " ", "=", " ", 
         RowBox[{"(", GridBox[{
            {"1", "0"},
            {"0", 
             RowBox[{"-", "1"}]}
           }], ")"}]}], 
        RowBox[{"(*", " ", 
         RowBox[{"jump", " ", "operator"}], "*)"}], "}"}], ",", "\n", "\t", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "\[CapitalGamma]"}], "/", "2"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"ID", ",", " ", 
            RowBox[{
             RowBox[{"J", "\[ConjugateTranspose]"}], ".", "J"}]}], "]"}], " ",
           "+", " ", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"J", "\[ConjugateTranspose]"}], ".", "J"}], ")"}], 
             "\[Transpose]"}], ",", " ", "ID"}], "]"}], " ", "-", " ", 
          RowBox[{"2", " ", 
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{
             RowBox[{"J", "\[Conjugate]"}], ",", " ", "J"}], "]"}]}]}], 
         ")"}]}]}], "\n", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Rho]D", " ", "=", " ", 
     RowBox[{"Partition", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"MatrixExp", "[", "lindbladZ", "]"}], ".", 
        RowBox[{"Flatten", "[", "\[Rho]", "]"}]}], ",", " ", "2"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<\!\(\*SuperscriptBox[\(e\), \(L\)]\)\[Rho] = \>\"", ",", " ", 
      RowBox[{"\[Rho]D", " ", "//", "MatrixForm"}]}], "]"}], 
    ";"}]}]}]], "Code",
