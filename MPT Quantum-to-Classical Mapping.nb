Cell[BoxData[{
 RowBox[{
  RowBox[{"lindbladSpont", " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"J", " ", "=", " ", 
       RowBox[{"(", GridBox[{
          {"0", "0"},
          {"1", "0"}
         }], ")"}]}], 
      RowBox[{"(*", " ", 
