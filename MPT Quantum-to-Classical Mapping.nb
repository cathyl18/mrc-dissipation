Cell[CellGroupData[{

Cell["Boltzmann weights and classical model parameters", "Subsubsection",
 CellChangeTimes->{{3.8855947623295326`*^9, 
  3.885594770116667*^9}},ExpressionUUID->"3c40111d-396d-4491-9ce3-\
782baee5ea73"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"boltzmannWeights", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Weingarten", "\[LeftDoubleBracket]", 
         RowBox[{"\[Sigma]3", ",", "\[Tau]"}], "\[RightDoubleBracket]"}], " ",
         "*", " ", 
        RowBox[{"wd2", "\[LeftDoubleBracket]", 
         RowBox[{"\[Sigma]1", ",", "\[Tau]"}], "\[RightDoubleBracket]"}], " ",
         "*", " ", 
        RowBox[{"wd2", "\[LeftDoubleBracket]", 
         RowBox[{"\[Sigma]2", ",", "\[Tau]"}], "\[RightDoubleBracket]"}]}], 
       ",", " ", 
       RowBox[{"{", 
        RowBox[{"\[Tau]", ",", "1", ",", "2"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Sigma]1", ",", "1", ",", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Sigma]2", ",", "1", ",", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Sigma]3", ",", "1", ",", "2"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"mapping", " ", "=", " ", 
   RowBox[{"Thread", "[", 
    RowBox[{"ClassicalMappingArgs", " ", "->", " ", 
     RowBox[{"ClassicalMapping", ".", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Log", "[", "boltzmannWeights", "]"}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Code",
 CellChangeTimes->{{3.885573830739832*^9, 3.8855738962127223`*^9}, {
  3.885594774834008*^9, 3.885594793502838*^9}},
 CellLabel->
  "In[123]:=",ExpressionUUID->"a6437145-9dbe-4bfc-b7f3-ded022b0564d"],

