Cell[CellGroupData[{

Cell["\<\
Boltzmann weights and classical model parameters (spontaneous emission)\
\>", "Subsubsection",
 CellChangeTimes->{{3.8855947623295326`*^9, 3.885594770116667*^9}, {
  3.8855950008683405`*^9, 
  3.8855950044130583`*^9}},ExpressionUUID->"aede7fd2-ec6b-4140-abec-\
c51a17727bd0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"boltzmannWeights", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Weingarten", "\[LeftDoubleBracket]", 
         RowBox[{"\[Sigma]3", ",", "\[Tau]"}], "\[RightDoubleBracket]"}], " ",
         "*", " ", 
        RowBox[{"wd2", "\[LeftDoubleBracket]", 
         RowBox[{"\[Sigma]1", ",", "\[Tau]"}], "\[RightDoubleBracket]"}], " ",
         "*", " ", 
        RowBox[{"wd2", "\[LeftDoubleBracket]", 
         RowBox[{"\[Sigma]2", ",", "\[Tau]"}], "\[RightDoubleBracket]"}]}], 
       ",", " ", 
       RowBox[{"{", 
        RowBox[{"\[Tau]", ",", "1", ",", "2"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Sigma]1", ",", "1", ",", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Sigma]2", ",", "1", ",", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Sigma]3", ",", "1", ",", "2"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"mappingSpont", " ", "=", " ", 
   RowBox[{"Thread", "[", 
    RowBox[{"ClassicalMappingArgs", " ", "->", " ", 
     RowBox[{"ClassicalMapping", ".", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Log", "[", "boltzmannWeights", "]"}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Code",
 CellChangeTimes->{{3.885573830739832*^9, 3.8855738962127223`*^9}, {
  3.885594774834008*^9, 3.885594793502838*^9}, {3.8855950269522667`*^9, 
