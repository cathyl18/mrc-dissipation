     RowBox[{
      RowBox[{"-", 
       FractionBox["\[CapitalGamma]", "2"]}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"ID", ",", " ", 
          RowBox[{
           RowBox[{"J", "\[ConjugateTranspose]"}], ".", "J"}]}], "]"}], " ", 
        "+", " ", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"J", "\[ConjugateTranspose]"}], ".", "J"}], ")"}], 
           "\[Transpose]"}], ",", " ", "ID"}], "]"}], " ", "-", " ", 
        RowBox[{"2", " ", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{
           RowBox[{"J", "\[Conjugate]"}], ",", " ", "J"}], "]"}]}]}], 
       ")"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Rho]D", " ", "=", " ", 
   RowBox[{
    RowBox[{"Partition", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"MatrixExp", "[", "lindbladSpont", "]"}], ".", 
       RowBox[{"Flatten", "[", "\[Rho]", "]"}]}], ",", " ", "2"}], "]"}], " ",
     "//", "Expand"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\[Rho]D", " ", "//", "MatrixForm"}], "]"}], ";"}]}], "Code",
